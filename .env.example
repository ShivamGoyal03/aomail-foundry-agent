# OmniPort Email Agent - local development environment.
# Copy to .env and fill in. NEVER commit a populated .env file.

# ---------------------------------------------------------------------------
# Model / Foundry
# ---------------------------------------------------------------------------
# Injected automatically when running as a Foundry hosted agent.
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
OMNIPORT_AGENT_NAME=OmniPortEmailAgent
PORT=8088
OMNIPORT_REQUEST_TIMEOUT_SECONDS=30
OMNIPORT_MAX_PAGE_SIZE=50
OMNIPORT_MAX_BODY_CHARACTERS=8000

# ---------------------------------------------------------------------------
# Identity boundary
# ---------------------------------------------------------------------------
# The calling application authenticates the end user and injects this header.
OMNIPORT_PRINCIPAL_HEADER=x-omniport-principal-id
# Shared secret used to HMAC-sign the principal header. Strongly recommended
# in any shared environment. Leave unset only for a single-user local run.
# OMNIPORT_PRINCIPAL_SIGNING_KEY=change-me
OMNIPORT_PRINCIPAL_SIGNATURE_HEADER=x-omniport-principal-signature

# LOCAL DEVELOPMENT ONLY: treat unauthenticated requests as this principal.
# Leave unset in every deployed environment.
OMNIPORT_DEV_PRINCIPAL_ID=local-dev

# Adds an in-memory mock mailbox so the agent runs without real credentials.
OMNIPORT_ENABLE_MOCK_ACCOUNT=1

# ---------------------------------------------------------------------------
# Mailboxes (JSON array). Secrets stay in this file / your secret store and
# are never placed in prompts or tool results.
# ---------------------------------------------------------------------------
# OMNIPORT_ACCOUNTS=[
#   {
#     "account_id": "gmail-personal",
#     "provider": "gmail",
#     "email": "user@gmail.com",
#     "principal_id": "local-dev",
